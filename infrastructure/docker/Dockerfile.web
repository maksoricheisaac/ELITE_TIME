# syntax=docker/dockerfile:1.7
# Frontend Next.js (mode standalone) — contexte de build : racine du dépôt
#   docker build -f infrastructure/docker/Dockerfile.web \
#     --build-arg NEXT_PUBLIC_API_URL=https://elitetime.example.com/api \
#     --build-arg NEXT_PUBLIC_SOCKET_URL= -t elitetime-web .
# Les variables NEXT_PUBLIC_* sont figées dans le bundle à la compilation.
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm CI=true
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@12.14.0 --activate
WORKDIR /repo

FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/shared/package.json packages/shared/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "web..."

FROM deps AS build
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SOCKET_URL
ARG NEXT_ALLOWED_ORIGINS
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SOCKET_URL=$NEXT_PUBLIC_SOCKET_URL \
    NEXT_ALLOWED_ORIGINS=$NEXT_ALLOWED_ORIGINS \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production
COPY apps/web apps/web
RUN pnpm --filter web build

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
ENV NODE_ENV=production PORT=3000 HOSTNAME=0.0.0.0 NEXT_TELEMETRY_DISABLED=1 TZ=Europe/Paris
# Serveur autonome + assets statiques (non inclus dans standalone)
COPY --from=build --chown=node:node /repo/apps/web/.next-build/standalone ./
COPY --from=build --chown=node:node /repo/apps/web/.next-build/static ./apps/web/.next-build/static
COPY --from=build --chown=node:node /repo/apps/web/public ./apps/web/public
USER node
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||3000)+'/login').then(r=>process.exit(r.status<500?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["tini", "--"]
CMD ["node", "apps/web/server.js"]
