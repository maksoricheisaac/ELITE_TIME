# syntax=docker/dockerfile:1.7
# Worker (BullMQ) — contexte de build : racine du dépôt
#   docker build -f infrastructure/docker/Dockerfile.worker -t elitetime-worker .
# Inclut Chromium (Playwright) : les rapports e-mail planifiés génèrent des PDF.
ARG NODE_VERSION=22

FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm CI=true
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@12.14.0 --activate
WORKDIR /repo

FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/shared/package.json packages/shared/
COPY packages/time/package.json packages/time/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "worker..."

FROM deps AS build
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
COPY packages packages
COPY apps/api apps/api
COPY apps/worker apps/worker
# "worker..." construit aussi api (le worker réutilise ses services compilés)
RUN pnpm --filter "worker..." build
RUN pnpm --filter worker deploy --prod /out/worker

FROM node:${NODE_VERSION}-bookworm-slim AS runtime
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
WORKDIR /app
COPY --from=build /out/worker /app
# Chromium + bibliothèques système (version de playwright résolue depuis l'installation de l'API)
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini \
    && PW="$(find /app/node_modules -path '*/playwright-core/cli.js' | head -n1)" \
    && node "$PW" install --with-deps chromium \
    && rm -rf /var/lib/apt/lists/* \
    && chmod -R a+rX /ms-playwright
RUN chown -R node:node /app
USER node
ENV NODE_ENV=production WORKER_HEALTH_PORT=4100 WORKER_HEALTH_HOST=0.0.0.0 TZ=Africa/Brazzaville
EXPOSE 4100
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.WORKER_HEALTH_PORT||4100)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
ENTRYPOINT ["tini", "--"]
CMD ["node", "dist/main.js"]
