# syntax=docker/dockerfile:1.7
# API NestJS — contexte de build : racine du dépôt
#   docker build -f infrastructure/docker/Dockerfile.api -t elitetime-api .
#   cible "migrate" : image d'exécution des migrations Prisma (service one-shot)
ARG NODE_VERSION=22

# ── Base : Node + pnpm (version figée par "packageManager") ───────────────────
FROM node:${NODE_VERSION}-bookworm-slim AS base
ENV PNPM_HOME=/pnpm CI=true
ENV PATH=$PNPM_HOME:$PATH
RUN corepack enable && corepack prepare pnpm@12.14.0 --activate
WORKDIR /repo

# ── Dépendances (couche cachée tant que les manifestes ne changent pas) ──────
FROM base AS deps
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
COPY apps/api/package.json apps/api/
COPY apps/web/package.json apps/web/
COPY apps/worker/package.json apps/worker/
COPY packages/config/package.json packages/config/
COPY packages/database/package.json packages/database/
COPY packages/shared/package.json packages/shared/
RUN --mount=type=cache,id=pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile --filter "api..."

# ── Build ────────────────────────────────────────────────────────────────────
FROM deps AS build
# Valeur factice : "prisma generate" n'ouvre aucune connexion (aucun secret ici)
ENV DATABASE_URL="postgresql://build:build@localhost:5432/build"
COPY packages packages
COPY apps/api apps/api
RUN pnpm --filter "api..." build
# Artefacts de production autonomes (dépendances prod uniquement)
RUN pnpm --filter api deploy --prod /out/api \
 && pnpm --filter @elitetime/database deploy /out/db

# ── Migrations (service one-shot, avant api/worker) ──────────────────────────
FROM node:${NODE_VERSION}-bookworm-slim AS migrate
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /db
COPY --from=build --chown=node:node /out/db /db
USER node
ENV NODE_ENV=production
ENTRYPOINT ["tini", "--"]
CMD ["node", "scripts/migrate.mjs"]

# ── Exécution ────────────────────────────────────────────────────────────────
FROM node:${NODE_VERSION}-bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends openssl ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /out/api /app
USER node
ENV NODE_ENV=production PORT=4000 HOST=0.0.0.0 TZ=Europe/Paris
EXPOSE 4000
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||4000)+'/api/health/live').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
# tini : transmet SIGTERM à Node (arrêt propre)
ENTRYPOINT ["tini", "--"]
CMD ["node", "dist/src/main.js"]
